# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key

# OpenRouter. Por defecto usa el router de modelos gratuitos (openrouter/free):
# 20 peticiones/minuto y 50/día (1.000/día si la cuenta ha comprado al menos 10 $ de créditos)
OPENROUTER_API_KEY=tu_openrouter_api_key
# Opcional: otro modelo (por ejemplo uno de pago)
OPENROUTER_MODEL=openrouter/free
# Ofertas que se puntúan como máximo por subida (deja margen bajo el cupo diario)
SCORING_MAX_POR_EJECUCION=40
# Pausa entre llamadas al modelo, en milisegundos
SCORING_DELAY_MS=3500

# API Server
PORT=3000

# Acceso de escritura (sin estas variables, la API rechaza todas las escrituras)
# Emails de Supabase Auth con permiso para editar, separados por comas
OWNER_EMAILS=tu_email_de_login@ejemplo.com
# Clave para la ingesta automatizada (cabecera x-api-key). Genera una larga, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_API_KEY=genera_una_clave_aleatoria_larga

# Telegram Bot
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token
TELEGRAM_CHAT_ID=tu_telegram_chat_id
